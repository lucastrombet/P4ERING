<h1>Create New User</h1>
<div class="row">
  <div class="col-md-6">
    <%= form_with(model: @user, local: true) do |f| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <h5>Errors:</h5>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      
      <div class="mb-3">
        <%= f.label :name, class: "form-label" %>
        <%= f.text_field :name, class: "form-control", required: true %>
      </div>
      
      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-control", required: true %>
      </div>
      
      <div class="mb-3 form-check">
        <%= f.check_box :admin, class: "form-check-input" %>
        <%= f.label :admin, "Admin Privileges", class: "form-check-label" %>
      </div>
      
      <div class="alert alert-info">
        <small>Default password will be set to: <strong>password123</strong></small>
      </div>
      
      <%= f.submit "Create User", class: "btn btn-primary" %>
      <%= link_to "Cancel", users_path, class: "btn btn-secondary" %>
    <% end %>
  </div>
</div>
