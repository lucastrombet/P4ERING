<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "My Submissions", submissions_path %></li>
    <li class="breadcrumb-item"><%= link_to @submission.exercise.title, @submission.exercise %></li>
    <li class="breadcrumb-item active">Submission #<%= @submission.id %></li>
  </ol>
</nav>

<div class="row">
  <div class="col-md-8">
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Submitted Code</h5>
        <span class="badge bg-secondary"><%= @submission.exercise.language %></span>
      </div>
      <div class="card-body p-0">
        <pre class="m-0 p-3 font-monospace" style="background:#1e1e1e; color:#d4d4d4; border-radius: 0 0 .375rem .375rem; overflow-x:auto;"><%= @submission.code %></pre>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card mb-3">
      <div class="card-header">Result</div>
      <div class="card-body">
        <% badge = case @submission.status
                   when 'completed'  then 'success'
                   when 'failed'     then 'danger'
                   when 'evaluating' then 'warning'
                   else                   'secondary'
                   end %>
        <p class="mb-2">
          <span class="badge bg-<%= badge %> fs-6"><%= @submission.status.upcase %></span>
        </p>
        <p class="text-muted small mb-0">
          Submitted <%= time_ago_in_words(@submission.created_at) %> ago
        </p>
      </div>
    </div>

    <% if @submission.feedback.present? %>
      <div class="card mb-3">
        <div class="card-header">Feedback</div>
        <div class="card-body">
          <pre class="mb-0 small" style="white-space: pre-wrap; word-break: break-word;"><%= @submission.feedback %></pre>
        </div>
      </div>
    <% end %>

    <% if @submission.status == 'evaluating' %>
      <div class="alert alert-warning">
        <i class="fas fa-spinner fa-spin me-2"></i>
        Evaluation in progress. Refresh to check status.
      </div>
    <% end %>

    <div class="d-grid gap-2">
      <%= link_to @submission.exercise, class: "btn btn-outline-secondary" do %>
        <i class="fas fa-redo me-1"></i> Try Again
      <% end %>
    </div>
  </div>
</div>
