<!DOCTYPE html>
<html>
  <head>
    <title><%= t("layout.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Flag Icons (language switcher) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icons/7.2.3/css/flag-icons.min.css">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="topbar">
      <div class="topbar-left">
        <% if user_signed_in? %>
          <button class="sidebar-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarCollapse"
                  aria-expanded="true" aria-controls="sidebarCollapse">
            <i class="fas fa-bars"></i>
          </button>
        <% end %>
        <%= link_to root_path, class: "topbar-brand" do %>
          <%= image_tag(I18n.locale == :"pt-BR" ? "/p4ering_navbar_dark_ptbr.svg" : "/p4ering_navbar_dark_en.svg",
              alt: "P4ering", height: "60") %>
        <% end %>
      </div>

      <div class="topbar-right">
        <div class="dropdown">
          <a class="topbar-link dropdown-toggle" href="#" id="localeDropdown" role="button" data-bs-toggle="dropdown"
             title="<%= t("layout.nav.locale.#{I18n.locale}") %>">
            <span class="<%= locale_flag_class(I18n.locale) %>"></span>
            <span class="visually-hidden"><%= t("layout.nav.locale.#{I18n.locale}") %></span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <% I18n.available_locales.each do |locale| %>
              <li>
                <%= link_to set_locale_path(locale: locale),
                    class: "dropdown-item d-flex align-items-center gap-2 #{'active' if I18n.locale == locale}" do %>
                  <span class="<%= locale_flag_class(locale) %>"></span>
                  <span><%= t("layout.nav.locale.#{locale}") %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>

        <% if user_signed_in? %>
          <div class="dropdown">
            <a class="topbar-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
              <i class="fas fa-user-circle me-1"></i>
              <%= current_user.name || current_user.email.split('@').first %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li>
                <%= link_to edit_user_registration_path, class: "dropdown-item" do %>
                  <i class="fas fa-user-edit me-2"></i> <%= t("layout.nav.profile_settings") %>
                <% end %>
              </li>
            </ul>
          </div>

          <%= button_to destroy_user_session_path, method: :delete, class: "btn-logout-topbar",
              data: { turbo_method: :delete, turbo_confirm: t("layout.nav.logout_confirm") } do %>
            <i class="fas fa-sign-out-alt me-1"></i> <%= t("layout.nav.logout") %>
          <% end %>
        <% else %>
          <%= link_to new_user_session_path, class: "topbar-link" do %>
            <i class="fas fa-sign-in-alt me-1"></i> <%= t("layout.nav.login") %>
          <% end %>
          <%= link_to new_user_registration_path, class: "btn btn-outline-light btn-sm" do %>
            <i class="fas fa-user-plus me-1"></i> <%= t("layout.nav.sign_up") %>
          <% end %>
        <% end %>
      </div>
    </nav>

    <div class="app-shell">
      <% if user_signed_in? %>
        <div class="collapse collapse-horizontal show" id="sidebarCollapse">
          <aside class="sidebar">
            <ul class="sidebar-nav">
              <li>
                <%= link_to exercises_path, class: "sidebar-link #{'active' if current_page?(exercises_path)}" do %>
                  <i class="fas fa-code"></i> <span><%= t("layout.nav.exercises") %></span>
                <% end %>
              </li>
              <li>
                <%= link_to submissions_path, class: "sidebar-link #{'active' if current_page?(submissions_path)}" do %>
                  <i class="fas fa-history"></i> <span><%= t("layout.nav.my_submissions") %></span>
                <% end %>
              </li>
              <li>
                <%= link_to new_game_session_path, class: "sidebar-link" do %>
                  <i class="fas fa-chess-board"></i> <span><%= t("layout.nav.p4checkers") %></span>
                <% end %>
              </li>
              <li>
                <%= link_to classrooms_path, class: "sidebar-link #{'active' if current_page?(classrooms_path)}" do %>
                  <i class="fas fa-chalkboard"></i>
                  <span><%= current_user.staff? ? t("layout.nav.join_classrooms") : t("layout.nav.classrooms") %></span>
                <% end %>
              </li>
              <% if current_user.staff? %>
                <li class="sidebar-divider"></li>
                <li>
                  <%= link_to professor_classrooms_path, class: "sidebar-link" do %>
                    <i class="fas fa-chalkboard"></i> <span><%= t("layout.nav.classrooms") %></span>
                  <% end %>
                </li>
                <li>
                  <%= link_to admin_exercises_path, class: "sidebar-link" do %>
                    <i class="fas fa-code"></i> <span><%= t("layout.nav.exercise_management") %></span>
                  <% end %>
                </li>
                <li>
                  <%= link_to admin_traffic_generators_path, class: "sidebar-link" do %>
                    <i class="fas fa-network-wired"></i> <span><%= t("layout.nav.generators") %></span>
                  <% end %>
                </li>
                <% if current_user.admin? %>
                  <li>
                    <%= link_to admin_dashboard_path, class: "sidebar-link" do %>
                      <i class="fas fa-chart-line"></i> <span><%= t("layout.nav.admin") %></span>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to users_path, class: "sidebar-link" do %>
                      <i class="fas fa-users"></i> <span><%= t("layout.nav.users") %></span>
                    <% end %>
                  </li>
                <% else %>
                  <li>
                    <%= link_to professor_dashboard_path, class: "sidebar-link" do %>
                      <i class="fas fa-chalkboard-teacher"></i> <span><%= t("layout.nav.professor_dashboard") %></span>
                    <% end %>
                  </li>
                <% end %>
              <% end %>
            </ul>
          </aside>
        </div>
      <% end %>

      <div class="app-content">
        <main class="container-fluid mt-4">
          <% if notice %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <i class="fas fa-check-circle me-2"></i>
              <%= notice %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>

          <% if alert %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <i class="fas fa-exclamation-triangle me-2"></i>
              <%= alert %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>

          <%= yield %>
        </main>

        <footer>
          <div class="container-fluid">
            <p>&copy; 2026 <%= image_tag "p4-logo.svg", alt: "P4", height: "18", class: "align-middle" %>ering. <%= t("layout.footer.tagline") %></p>
            <p>
              <a href="#"><i class="fab fa-github"></i> <%= t("layout.footer.github") %></a> |
              <a href="#"><i class="fab fa-twitter"></i> <%= t("layout.footer.twitter") %></a> |
              <a href="#"><i class="fas fa-envelope"></i> <%= t("layout.footer.contact") %></a>
            </p>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>
