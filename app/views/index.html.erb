<h1>My Submissions</h1>

<div class="row mt-4">
  <div class="col-md-12">
    <% if @submissions.present? %>
      <div class="list-group">
        <% @submissions.each do |submission| %>
          <%= link_to submission_path(submission), class: "list-group-item list-group-item-action" do %>
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h5 class="mb-1"><%= submission.exercise.title %></h5>
                <small class="text-muted">Submitted <%= time_ago_in_words(submission.created_at) %> ago</small>
              </div>
              <div>
                <span class="badge bg-<%= submission.status == 'completed' ? 'success' : 'warning' %> me-2">
                  <%= submission.status.upcase %>
                </span>
                <small>View →</small>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="alert alert-info">
        You haven't submitted any exercises yet. 
        <%= link_to "Browse exercises", exercises_path %> to get started!
      </div>
    <% end %>
  </div>
</div>
