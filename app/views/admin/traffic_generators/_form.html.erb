<% if traffic_generator.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% traffic_generator.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="row g-3">
  <div class="col-md-8">
    <%= f.label :name, t(".name"), class: "form-label fw-bold" %>
    <%= f.text_field :name, class: "form-control", placeholder: t(".name_placeholder"), required: true %>
  </div>

  <div class="col-md-4">
    <%= f.label :protocol, t(".protocol"), class: "form-label fw-bold" %>
    <%= f.select :protocol, TrafficGenerator::PROTOCOLS,
        {}, { class: "form-select", required: true } %>
  </div>

  <div class="col-12">
    <%= f.label :description, t(".description"), class: "form-label fw-bold" %>
    <%= f.text_area :description, rows: 3, class: "form-control",
        placeholder: t(".description_placeholder") %>
  </div>

  <div class="col-md-3">
    <%= f.label :duration, t(".duration"), class: "form-label fw-bold" %>
    <%= f.number_field :duration, class: "form-control", min: 1, required: true %>
  </div>

  <div class="col-md-3">
    <%= f.label :port, t(".port"), class: "form-label fw-bold" %>
    <%= f.number_field :port, class: "form-control", min: 1, max: 65535, required: true %>
  </div>

  <div class="col-md-3">
    <%= f.label :bandwidth, t(".bandwidth"), class: "form-label fw-bold" %>
    <%= f.text_field :bandwidth, class: "form-control", placeholder: "e.g. 10M, 1G" %>
    <div class="form-text"><%= t(".bandwidth_hint") %></div>
  </div>

  <div class="col-md-3">
    <%= f.label :parallel_streams, t(".parallel_streams"), class: "form-label fw-bold" %>
    <%= f.number_field :parallel_streams, class: "form-control", min: 1 %>
  </div>

  <div class="col-md-3">
    <%= f.label :packet_length, t(".packet_length"), class: "form-label fw-bold" %>
    <%= f.text_field :packet_length, class: "form-control", placeholder: "e.g. 1400, 64K" %>
  </div>

  <div class="col-md-3">
    <%= f.label :interval, t(".interval"), class: "form-label fw-bold" %>
    <%= f.number_field :interval, class: "form-control", min: 1 %>
  </div>

  <div class="col-md-3">
    <%= f.label :tos, t(".tos"), class: "form-label fw-bold" %>
    <%= f.text_field :tos, class: "form-control", placeholder: "e.g. 0x10, 0x28" %>
  </div>

  <div class="col-md-3 d-flex align-items-end">
    <div class="form-check mb-2">
      <%= f.check_box :reverse, class: "form-check-input" %>
      <%= f.label :reverse, class: "form-check-label" do %>
        <strong><%= t(".reverse") %></strong>
        <div class="text-muted small"><%= t(".reverse_hint") %></div>
      <% end %>
    </div>
  </div>
</div>

<% if traffic_generator.persisted? %>
  <div class="mt-4 p-3 bg-light rounded">
    <p class="mb-1 small text-muted fw-bold"><%= t(".generated_command") %></p>
    <code class="small"><%= traffic_generator.to_iperf_command("<server>") %></code>
  </div>
<% end %>
