<div id="game-session-status-<%= game_session.id %>" class="card mb-3">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <% badge = case game_session.status
                 when 'active'  then 'success'
                 when 'pending' then 'warning'
                 when 'failed'  then 'danger'
                 else                'secondary'
                 end %>
      <span class="badge bg-<%= badge %> fs-6">
        <% if game_session.status == 'pending' %>
          <i class="fas fa-spinner fa-spin me-1"></i>
        <% end %>
        <%= t("game_sessions.status.#{game_session.status}").upcase %>
      </span>
      <span class="ms-2 text-muted small">
        <%= t("game_sessions.status_card.#{game_session.status}", error: game_session.error) %>
      </span>
    </div>
    <% if game_session.status == 'active' %>
      <%= button_to game_session_path(game_session), method: :delete,
          class: "btn btn-outline-danger btn-sm",
          form: { data: { turbo_confirm: t('game_sessions.show.leave_confirm') } } do %>
        <i class="fas fa-stop me-1"></i><%= t('game_sessions.show.leave') %>
      <% end %>
    <% end %>
  </div>
</div>
