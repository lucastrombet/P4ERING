<div class="row mb-4"
     data-controller="topology-viewer"
     data-topology-viewer-topo-value="<%= exercise.topology_config %>"
     data-topology-viewer-i18n-value="<%= {
       port:              t('.js.port'),
       p4Switch:          t('.js.p4_switch'),
       host:              t('.js.host'),
       link:              t('.js.link'),
       image:             t('.js.image'),
       thriftPort:        t('.js.thrift_port'),
       ipCidr:            t('.js.ip_cidr'),
       mac:               t('.js.mac'),
       connectedToSwitch: t('.js.connected_to_switch'),
       swIp:              t('.js.sw_ip'),
       swMac:             t('.js.sw_mac'),
       hostSide:          t('.js.host_side'),
       switchSide:        t('.js.switch_side'),
       bandwidth:         t('.js.bandwidth'),
       delay:             t('.js.delay'),
       clickHint:         t('.click_hint')
     }.to_json %>">
  <div class="col-12">
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <span><i class="fas fa-project-diagram me-2"></i><strong><%= t(".network_topology") %></strong></span>
        <span class="badge bg-secondary small font-monospace"><%= exercise.topology_config.then { |t| JSON.parse(t)['switch']['name'] rescue 'topology' } %></span>
      </div>

      <div class="card-body p-0">
        <div class="container-fluid g-0">
          <div class="row g-0">

            <%# ── Cytoscape canvas ── %>
            <div class="col-md-9" style="border-right:1px solid #dee2e6; position:relative;">
              <div data-topology-viewer-target="canvas"
                   style="width:100%; height:400px; background:#f0f4f8;"></div>

              <%# zoom controls (matching P4Docker's + / - buttons) %>
              <div style="position:absolute; top:10px; right:18px; display:flex; gap:4px; z-index:10;">
                <button type="button" data-action="topology-viewer#zoomIn"
                        class="btn btn-sm btn-light border" title="<%= t(".zoom_in") %>">+</button>
                <button type="button" data-action="topology-viewer#zoomOut"
                        class="btn btn-sm btn-light border" title="<%= t(".zoom_out") %>">−</button>
                <button type="button" data-action="topology-viewer#fit"
                        class="btn btn-sm btn-light border" title="<%= t(".fit_to_view") %>">&#x26F6;</button>
              </div>
            </div>

            <%# ── Info panel (mirrors P4Docker's #info-box) ── %>
            <div class="col-md-3 p-3 d-flex flex-column">
              <div class="small text-muted fw-semibold mb-2">
                <i class="fas fa-info-circle me-1"></i> <%= t(".info") %>
              </div>
              <div data-topology-viewer-target="info"
                   class="small p-2 rounded flex-grow-1"
                   style="background:#fff; border:1px solid #dee2e6; min-height:180px; overflow-y:auto;">
                <span class="text-muted"><%= t(".click_hint") %></span>
              </div>

              <%# legend %>
              <div class="mt-3 small text-muted">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <span style="display:inline-block;width:18px;height:18px;background:#0d6efd;border-radius:3px;"></span>
                  <%= t(".legend_switch") %>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span style="display:inline-block;width:18px;height:18px;background:#198754;border-radius:50%;"></span>
                  <%= t(".legend_host") %>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>
