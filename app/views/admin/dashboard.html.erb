<h1 class="mb-4">Admin Dashboard</h1>

<div class="row mb-4">
  <div class="col-md-3">
    <div class="card text-white bg-primary">
      <div class="card-body">
        <h5 class="card-title">Total Users</h5>
        <p class="card-text display-4"><%= @users.count %></p>
      </div>
    </div>
  </div>
  
  <div class="col-md-3">
    <div class="card text-white bg-success">
      <div class="card-body">
        <h5 class="card-title">Exercises</h5>
        <p class="card-text display-4"><%= @exercises.count %></p>
      </div>
    </div>
  </div>
  
  <div class="col-md-3">
    <div class="card text-white bg-info">
      <div class="card-body">
        <h5 class="card-title">Submissions</h5>
        <p class="card-text display-4"><%= @total_submissions %></p>
      </div>
    </div>
  </div>
  
  <div class="col-md-3">
    <div class="card text-white bg-warning">
      <div class="card-body">
        <h5 class="card-title">Completed</h5>
        <p class="card-text display-4"><%= @completed_submissions %></p>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h4>Quick Actions</h4>
      </div>
      <div class="card-body">
        <%= link_to "Create New Exercise", new_exercise_path, class: "btn btn-primary btn-sm me-2" %>
        <%= link_to "Add New User", new_user_path, class: "btn btn-success btn-sm" %>
      </div>
    </div>
  </div>
  
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h4>Recent Submissions</h4>
      </div>
      <div class="card-body" style="max-height: 400px; overflow-y: auto;">
        <% @submissions.each do |submission| %>
          <div class="border-bottom pb-2 mb-2">
            <strong><%= submission.user.name || submission.user.email %></strong>
            completed 
            <strong><%= link_to submission.exercise.title, submission.exercise %></strong>
            <br>
            <small class="text-muted"><%= time_ago_in_words(submission.created_at) %> ago</small>
            <span class="badge bg-<%= submission.status == 'completed' ? 'success' : 'warning' %> float-end">
              <%= submission.status %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
