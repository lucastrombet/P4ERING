<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t(".title") %></h1>
  <%= link_to t(".create_new_user"), new_user_path, class: "btn btn-primary" %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th><%= t("activerecord.attributes.user.name") %></th>
        <th><%= t("activerecord.attributes.user.email") %></th>
        <th><%= t(".role") %></th>
        <th><%= t(".submissions") %></th>
        <th><%= t(".joined") %></th>
        <th><%= t(".actions") %></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.name || t(".not_set") %></td>
          <td><%= user.email %></td>
          <td>
            <% if user.admin? %>
              <span class="badge bg-danger"><%= t(".admin") %></span>
            <% else %>
              <span class="badge bg-secondary"><%= t(".user") %></span>
            <% end %>
          </td>
          <td><%= user.submissions.count %></td>
          <td><%= user.created_at.strftime("%Y-%m-%d") %></td>
          <td>
            <%= link_to t(".edit"), edit_user_path(user), class: "btn btn-sm btn-warning" %>
            <%= button_to t(".delete"), user_path(user), method: :delete,
                class: "btn btn-sm btn-danger",
                data: { confirm: t(".confirm_delete") } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
