<div class="card mb-3">
  <div class="card-header bg-dark text-white d-flex align-items-center gap-2">
    <i class="fas fa-fish"></i>
    <span class="small fw-semibold"><%= title %></span>
  </div>

  <div class="px-2 pt-2 pb-1" style="background:#1e1e1e;">
    <input type="text"
           class="form-control form-control-sm font-monospace"
           style="background:#2d2d2d; color:#d4d4d4; border-color:#444;"
           placeholder="<%= t('game_sessions.show.filter_placeholder') %>"
           data-controller="wireshark"
           data-wireshark-target="filter"
           data-action="input->wireshark#filter"
           data-table-id="packet-table-<%= host %>">
  </div>

  <div style="overflow-x:auto; max-height:280px; overflow-y:auto;">
    <table class="table table-sm table-hover mb-0 font-monospace small"
           id="packet-table-<%= host %>"
           style="font-size:0.72rem;">
      <thead style="position:sticky; top:0; background:#2d2d2d; color:#ccc; z-index:1;">
        <tr>
          <th class="ps-2" style="width:5rem;"><%= t('game_sessions.show.columns.time') %></th>
          <th><%= t('game_sessions.show.columns.source') %></th>
          <th><%= t('game_sessions.show.columns.destination') %></th>
          <th style="width:4rem;"><%= t('game_sessions.show.columns.proto') %></th>
          <th style="width:3rem;"><%= t('game_sessions.show.columns.len') %></th>
          <th><%= t('game_sessions.show.columns.info') %></th>
        </tr>
      </thead>
      <tbody id="packet-table-<%= host %>-body"></tbody>
    </table>
  </div>
</div>
