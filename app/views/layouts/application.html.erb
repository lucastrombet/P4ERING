<!DOCTYPE html>
<html>
  <head>
    <title><%= t("layout.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Flag Icons (language switcher) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icons/7.2.3/css/flag-icons.min.css">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand fw-bold d-flex align-items-center" do %>
          <%= image_tag "p4-logo.svg", alt: "P4", height: "28", class: "navbar-brand-icon" %><span class="navbar-brand-suffix">ering</span>
        <% end %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <% if user_signed_in? %>
              <li class="nav-item">
                <%= link_to exercises_path, class: "nav-link" do %>
                  <i class="fas fa-code me-1"></i> <%= t("layout.nav.exercises") %>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to submissions_path, class: "nav-link" do %>
                  <i class="fas fa-history me-1"></i> <%= t("layout.nav.my_submissions") %>
                <% end %>
              </li>
              <% if current_user.staff? %>
                <li class="nav-item">
                  <%= link_to professor_classrooms_path, class: "nav-link" do %>
                    <i class="fas fa-chalkboard me-1"></i> <%= t("layout.nav.classrooms") %>
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to admin_exercises_path, class: "nav-link" do %>
                    <i class="fas fa-code me-1"></i> <%= t("layout.nav.exercise_management") %>
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to admin_traffic_generators_path, class: "nav-link" do %>
                    <i class="fas fa-network-wired me-1"></i> <%= t("layout.nav.generators") %>
                  <% end %>
                </li>
                <% if current_user.admin? %>
                  <li class="nav-item">
                    <%= link_to admin_dashboard_path, class: "nav-link" do %>
                      <i class="fas fa-chart-line me-1"></i> <%= t("layout.nav.admin") %>
                    <% end %>
                  </li>
                <% else %>
                  <li class="nav-item">
                    <%= link_to professor_dashboard_path, class: "nav-link" do %>
                      <i class="fas fa-chalkboard-teacher me-1"></i> <%= t("layout.nav.professor_dashboard") %>
                    <% end %>
                  </li>
                <% end %>
                <% if current_user.admin? %>
                  <li class="nav-item">
                    <%= link_to users_path, class: "nav-link" do %>
                      <i class="fas fa-users me-1"></i> <%= t("layout.nav.users") %>
                    <% end %>
                  </li>
                <% end %>
              <% end %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                  <i class="fas fa-user-circle me-1"></i>
                  <%= current_user.name || current_user.email.split('@').first %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <%= link_to edit_user_registration_path, class: "dropdown-item" do %>
                      <i class="fas fa-user-edit me-2"></i> <%= t("layout.nav.profile_settings") %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to submissions_path, class: "dropdown-item" do %>
                      <i class="fas fa-tasks me-2"></i> <%= t("layout.nav.my_submissions") %>
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger",
                        form: { style: "display: inline-block; width: 100%;" },
                        data: { turbo_method: :delete, turbo_confirm: t("layout.nav.logout_confirm") } do %>
                      <i class="fas fa-sign-out-alt me-2"></i> <%= t("layout.nav.logout") %>
                    <% end %>
                  </li>
                </ul>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to new_user_session_path, class: "nav-link" do %>
                  <i class="fas fa-sign-in-alt me-1"></i> <%= t("layout.nav.login") %>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to new_user_registration_path, class: "nav-link btn btn-outline-light ms-2" do %>
                  <i class="fas fa-user-plus me-1"></i> <%= t("layout.nav.sign_up") %>
                <% end %>
              </li>
            <% end %>
            <li class="nav-item dropdown ms-lg-2">
              <a class="nav-link dropdown-toggle" href="#" id="localeDropdown" role="button" data-bs-toggle="dropdown"
                 title="<%= t("layout.nav.locale.#{I18n.locale}") %>">
                <span class="<%= locale_flag_class(I18n.locale) %>"></span>
                <span class="visually-hidden"><%= t("layout.nav.locale.#{I18n.locale}") %></span>
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                <% I18n.available_locales.each do |locale| %>
                  <li>
                    <%= link_to set_locale_path(locale: locale),
                        class: "dropdown-item d-flex align-items-center gap-2 #{'active' if I18n.locale == locale}" do %>
                      <span class="<%= locale_flag_class(locale) %>"></span>
                      <span><%= t("layout.nav.locale.#{locale}") %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </nav>
    
    <main class="container mt-4">
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="fas fa-check-circle me-2"></i>
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      
      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="fas fa-exclamation-triangle me-2"></i>
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      
      <%= yield %>
    </main>
    <% if user_signed_in? %>
      <div class="floating-logout">
        <%= button_to destroy_user_session_path,
            method: :delete,
            class: "btn-logout",
            data: {
              turbo_method: :delete,
              turbo_confirm: t("layout.nav.logout_confirm")
            } do %>
          <i class="fas fa-sign-out-alt"></i>
        <% end %>
      </div>
    <% end %>
    
    <footer>
      <div class="container">
        <p>&copy; 2024 <%= image_tag "p4-logo.svg", alt: "P4", height: "18", class: "align-middle" %>ering. <%= t("layout.footer.tagline") %></p>
        <p>
          <a href="#"><i class="fab fa-github"></i> <%= t("layout.footer.github") %></a> |
          <a href="#"><i class="fab fa-twitter"></i> <%= t("layout.footer.twitter") %></a> |
          <a href="#"><i class="fas fa-envelope"></i> <%= t("layout.footer.contact") %></a>
        </p>
      </div>
    </footer>
    
  </body>
</html>
