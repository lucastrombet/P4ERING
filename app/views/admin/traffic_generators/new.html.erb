<div class="row justify-content-center">
  <div class="col-lg-9">
    <div class="card shadow-sm">
      <div class="card-header bg-primary text-white">
        <h2 class="h5 mb-0"><i class="fas fa-network-wired me-2"></i><%= t(".title") %></h2>
      </div>
      <div class="card-body">
        <%= form_with model: [:admin, @traffic_generator], local: true do |f| %>
          <%= render 'form', f: f, traffic_generator: @traffic_generator %>
          <div class="d-flex justify-content-between mt-4 pt-3 border-top">
            <%= link_to admin_traffic_generators_path, class: "btn btn-secondary" do %>
              <i class="fas fa-arrow-left me-1"></i> <%= t("admin.traffic_generators.form.cancel") %>
            <% end %>
            <%= f.submit t(".submit"), class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
