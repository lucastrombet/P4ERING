<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>My Submissions</h1>
  <%= link_to "Browse Exercises", exercises_path, class: "btn btn-outline-primary" %>
</div>

<% if @submissions.empty? %>
  <div class="alert alert-info text-center">
    You haven't submitted any solutions yet.
    <%= link_to "Start an exercise", exercises_path %> to get going!
  </div>
<% else %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>Exercise</th>
          <th>Language</th>
          <th>Status</th>
          <th>Submitted</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @submissions.each do |submission| %>
          <tr>
            <td class="fw-semibold"><%= submission.exercise.title %></td>
            <td><span class="badge bg-secondary"><%= submission.exercise.language %></span></td>
            <td>
              <% badge = case submission.status
                         when 'completed'  then 'success'
                         when 'failed'     then 'danger'
                         when 'evaluating' then 'warning'
                         else                   'secondary'
                         end %>
              <span class="badge bg-<%= badge %>"><%= submission.status.upcase %></span>
            </td>
            <td class="text-muted small"><%= time_ago_in_words(submission.created_at) %> ago</td>
            <td><%= link_to "View", submission, class: "btn btn-sm btn-outline-primary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
