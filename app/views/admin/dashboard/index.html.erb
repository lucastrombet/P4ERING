<h1 class="mb-4"><%= t(".title") %></h1>

<div class="row mb-4">
  <div class="col-md-3">
    <div class="card text-white bg-primary">
      <div class="card-body">
        <h5 class="card-title"><%= t(".total_users") %></h5>
        <p class="card-text display-4"><%= @users.count %></p>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card text-white bg-success">
      <div class="card-body">
        <h5 class="card-title"><%= t(".exercises") %></h5>
        <p class="card-text display-4"><%= @exercises.count %></p>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card text-white bg-info">
      <div class="card-body">
        <h5 class="card-title"><%= t(".submissions") %></h5>
        <p class="card-text display-4"><%= @total_submissions %></p>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card text-white bg-warning">
      <div class="card-body">
        <h5 class="card-title"><%= t(".completed") %></h5>
        <p class="card-text display-4"><%= @completed_submissions %></p>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h4><%= t(".quick_actions") %></h4>
      </div>
      <div class="card-body">
        <%= link_to t(".create_new_exercise"), new_exercise_path, class: "btn btn-primary btn-sm me-2" %>
        <%= link_to t(".add_new_user"), new_user_path, class: "btn btn-success btn-sm" %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h4><%= t(".recent_submissions") %></h4>
      </div>
      <div class="card-body" style="max-height: 400px; overflow-y: auto;">
        <% @submissions.each do |submission| %>
          <div class="border-bottom pb-2 mb-2">
            <strong><%= submission.user.name || submission.user.email %></strong>
            <%= t(".completed_lowercase") %>
            <strong><%= link_to submission.exercise.title, submission.exercise %></strong>
            <br>
            <small class="text-muted"><%= t("exercises.show.time_ago", time: time_ago_in_words(submission.created_at)) %></small>
            <span class="badge bg-<%= submission.status == 'completed' ? 'success' : 'warning' %> float-end">
              <%= t("submissions.status.#{submission.status}") %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
