<!-- app/views/admin/exercises/index.html.erb -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="text-gradient">
      <i class="fas fa-dumbbell me-2"></i><%= t(".title") %>
    </h1>
    <p class="text-muted"><%= t(".subtitle") %></p>
  </div>
  <%= link_to new_admin_exercise_path, class: "btn btn-primary btn-lg" do %>
    <i class="fas fa-plus me-2"></i><%= t(".create_new_exercise") %>
  <% end %>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th><%= t(".columns.title") %></th>
            <th><%= t(".columns.owner") %></th>
            <th><%= t(".columns.language") %></th>
            <th><%= t(".columns.difficulty") %></th>
            <th><%= t(".columns.submissions") %></th>
            <th><%= t(".columns.created") %></th>
            <th><%= t(".columns.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @exercises.each do |exercise| %>
            <tr>
              <td><%= exercise.id %></td>
              <td>
                <strong><%= exercise.title %></strong>
                <% if exercise.restricted? %>
                  <span class="badge bg-warning text-dark ms-1"><i class="fas fa-lock me-1"></i><%= t("admin.exercises.index.restricted") %></span>
                <% end %>
                <% if exercise.in_use? %>
                  <span class="badge bg-danger ms-1" title="<%= t(".in_use_hint") %>"><i class="fas fa-chalkboard-teacher me-1"></i><%= t(".in_use") %></span>
                <% end %>
                <% unless exercise.visible_by_other_professors? %>
                  <span class="badge bg-secondary ms-1"><i class="fas fa-eye-slash me-1"></i><%= t(".private") %></span>
                <% end %>
                <br>
                <small class="text-muted"><%= truncate(exercise.description, length: 50) %></small>
              </td>
              <td>
                <small><%= exercise.owner&.name || exercise.owner&.email || "—" %></small>
              </td>
              <td>
                <span class="badge bg-info">
                  <i class="fas fa-code me-1"></i><%= exercise.language %>
                </span>
              </td>
              <td>
                <div class="difficulty-stars">
                  <% exercise.difficulty.times do %>
                    <i class="fas fa-star text-warning"></i>
                  <% end %>
                  <% (5 - exercise.difficulty).times do %>
                    <i class="far fa-star text-muted"></i>
                  <% end %>
                </div>
              </td>
              <td>
                <span class="badge bg-secondary">
                  <%= t(".submissions_count", count: exercise.submissions.count) %>
                </span>
              </td>
              <td>
                <small><%= t("exercises.show.time_ago", time: time_ago_in_words(exercise.created_at)) %></small>
              </td>
              <td>
                <div class="btn-group" role="group">
                  <%= button_to duplicate_admin_exercise_path(exercise),
                      method: :post,
                      class: "btn btn-sm btn-info",
                      title: t(".duplicate"),
                      form: { data: { turbo_confirm: t(".confirm_duplicate", title: exercise.title) } } do %>
                    <i class="fas fa-copy"></i>
                  <% end %>
                  <% if exercise.editable_by?(current_user) %>
                    <%= link_to edit_admin_exercise_path(exercise), class: "btn btn-sm btn-warning" do %>
                      <i class="fas fa-edit"></i>
                    <% end %>
                    <%= link_to admin_exercise_path(exercise),
                        method: :delete,
                        class: "btn btn-sm btn-danger",
                        data: { confirm: t(".confirm_delete", title: exercise.title) } do %>
                      <i class="fas fa-trash"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @exercises.empty? %>
      <div class="text-center py-5">
        <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
        <h3><%= t(".no_exercises") %></h3>
        <p class="text-muted"><%= t(".no_exercises_hint") %></p>
      </div>
    <% end %>
  </div>
</div>
