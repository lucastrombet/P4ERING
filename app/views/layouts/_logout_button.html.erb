<div class="logout-button-container">
  <%= button_to destroy_user_session_path, 
      method: :delete,
      class: "btn btn-danger btn-lg logout-btn",
      data: { 
        turbo_method: :delete,
        turbo_confirm: "Are you sure you want to logout?" 
      } do %>
    <i class="fas fa-sign-out-alt me-2"></i>
    Logout
  <% end %>
</div>
