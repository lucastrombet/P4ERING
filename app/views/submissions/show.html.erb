<% if @submission.status.in?(%w[pending evaluating]) %>
  <%= turbo_stream_from "submission_#{@submission.id}" %>
<% end %>

<% if @submission.test_run? %>
  <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
    <i class="fas fa-flask fa-lg"></i>
    <div>
      <strong><%= t(".test_run") %></strong> — <%= t(".test_run_body") %>
      <%= link_to t(".back_to_exercise"), @submission.exercise, class: "alert-link ms-2" %>
    </div>
  </div>
<% end %>

<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t("layout.nav.my_submissions"), submissions_path %></li>
    <li class="breadcrumb-item"><%= link_to @submission.exercise.title, @submission.exercise %></li>
    <li class="breadcrumb-item active"><%= t(".submission_number", id: @submission.id) %></li>
  </ol>
</nav>

<div class="row">
  <div class="col-md-8">
    <%# Packet captures — empty placeholder replaced live via Turbo Streams on done %>
    <%= render 'packet_captures', submission: @submission %>

    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><%= t(".submitted_code") %></h5>
        <span class="badge bg-secondary"><%= @submission.exercise.language %></span>
      </div>
      <div class="card-body p-0">
        <pre class="m-0 p-3 font-monospace" style="background:#1e1e1e; color:#d4d4d4; border-radius: 0 0 .375rem .375rem; overflow-x:auto;"><%= @submission.code %></pre>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <%# Status card — replaced live via Turbo Streams when done %>
    <%= render 'status_card', submission: @submission %>

    <%# Live output panel — visible while evaluating, removed via Turbo Streams on done %>
    <% if @submission.status.in?(%w[pending evaluating]) %>
      <div id="exec-live-log-<%= @submission.id %>" class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2 bg-dark text-white">
          <i class="fas fa-terminal"></i>
          <span class="small fw-semibold"><%= t(".live_output") %></span>
          <span class="ms-auto d-flex align-items-center gap-2">
            <span class="badge bg-warning text-dark small">
              <i class="fas fa-circle-notch fa-spin me-1"></i><%= t(".running") %>
            </span>
            <button type="button"
                    class="btn btn-sm btn-outline-light py-0 px-1"
                    title="<%= t(".reconnect_stream") %>"
                    data-action="click->exec-log#refresh">
              <i class="fas fa-sync-alt" style="font-size:0.7rem;"></i>
            </button>
          </span>
        </div>
        <div class="card-body p-0">
          <pre data-controller="exec-log"
               id="exec-log-<%= @submission.id %>"
               class="m-0 p-3 small font-monospace"
               style="background:#1e1e1e; color:#d4d4d4; height:320px; overflow-y:auto;
                      border-radius: 0 0 .375rem .375rem; white-space:pre-wrap;
                      word-break:break-word;"></pre>
        </div>
      </div>
    <% end %>

    <%# Feedback sections — populated live via Turbo Streams on done %>
    <%= render 'feedback_sections', submission: @submission %>

    <%# Automated evaluation result — populated live via Turbo Streams on done %>
    <%= render 'evaluation_result', submission: @submission %>

    <div class="d-grid gap-2 mt-2">
      <%= link_to @submission.exercise, class: "btn btn-outline-secondary" do %>
        <i class="fas fa-redo me-1"></i> <%= t(".try_again") %>
      <% end %>
    </div>
  </div>
</div>
