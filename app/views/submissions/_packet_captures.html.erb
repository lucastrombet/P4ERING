<div id="packet-captures-<%= submission.id %>">
  <% caps = submission.parsed_packet_captures %>
  <% structured = submission.parsed_structured_packet_captures %>
  <% if caps.present? %>
    <div class="card mb-3">
      <div class="card-header bg-dark text-white d-flex align-items-center gap-2">
        <i class="fas fa-fish"></i>
        <span class="small fw-semibold"><%= t(".packet_captures") %></span>
        <span class="badge bg-secondary ms-auto small"><%= t(".packets_count", count: caps.values.sum { |t| t.lines.count { |l| l =~ /\A\d+\.\d+/ } }) %></span>
      </div>

      <div data-controller="tabs">
      <%# Tabs — one per host %>
      <ul class="nav nav-tabs nav-fill px-2 pt-2 packet-host-tabs" role="tablist">
        <% caps.each_with_index do |(host_name, _), i| %>
          <li class="nav-item" role="presentation">
            <button class="nav-link <%= 'active' if i == 0 %>"
                    id="cap-tab-<%= submission.id %>-<%= host_name %>"
                    data-tabs-target="btn"
                    data-action="click->tabs#show"
                    data-tab-pane="cap-pane-<%= submission.id %>-<%= host_name %>"
                    type="button" role="tab">
              <i class="fas fa-server me-1"></i><%= host_name %>
            </button>
          </li>
        <% end %>
      </ul>

      <div class="tab-content">
        <% caps.each_with_index do |(host_name, raw), i| %>
          <div class="tab-pane fade <%= 'show active' if i == 0 %>"
               id="cap-pane-<%= submission.id %>-<%= host_name %>"
               data-tabs-target="pane"
               role="tabpanel">

            <%# Filter input %>
            <div class="px-2 pt-2 pb-1 packet-light-bar">
              <input type="text"
                     class="form-control form-control-sm font-monospace"
                     placeholder="<%= t(".filter_placeholder") %>"
                     data-controller="wireshark"
                     data-wireshark-target="filter"
                     data-action="input->wireshark#filter"
                     data-table-id="cap-table-<%= submission.id %>-<%= host_name %>">
            </div>

            <% packets = parse_tcpdump_output(raw) %>
            <% structured_pkts = structured&.dig(host_name) || [] %>
            <% if packets.empty? %>
              <p class="text-muted small p-3 mb-0"><%= t(".no_packets", host: host_name) %></p>
            <% else %>
              <div style="overflow-x:auto; max-height:340px; overflow-y:auto;">
                <table class="table table-sm table-hover packet-capture-table mb-0 font-monospace small"
                       id="cap-table-<%= submission.id %>-<%= host_name %>"
                       style="font-size:0.72rem;">
                  <thead style="position:sticky; top:0; background:#2d2d2d; color:#ccc; z-index:1;">
                    <tr>
                      <th class="ps-2" style="width:3.5rem;">#</th>
                      <th style="width:5rem;"><%= t(".columns.time") %></th>
                      <th><%= t(".columns.source") %></th>
                      <th><%= t(".columns.destination") %></th>
                      <th style="width:4rem;"><%= t(".columns.proto") %></th>
                      <th style="width:3rem;"><%= t(".columns.len") %></th>
                      <th><%= t(".columns.info") %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% packets.each do |pkt| %>
                      <% structured_pkt = structured_pkts[pkt[:no] - 1] %>
                      <% detail_id = "pkt-detail-#{submission.id}-#{host_name}-#{pkt[:no]}" %>
                      <% colors = packet_row_colors(pkt[:proto], structured_pkt) %>
                      <% row_style = [] %>
                      <%# Bootstrap 5.3 paints color/background-color per-cell via
    .table > :not(caption) > * > *, so a plain style on the <tr> is
    covered by the cells — the row must set Bootstrap's own table
    variables instead (same mechanism as .table-danger & friends). %>
<% row_style += ["--bs-table-color:#{colors[:fg]}", "--bs-table-bg:#{colors[:bg]}"] if colors %>
                      <% row_style << "cursor:default" unless structured_pkt.present? %>
                      <tr class="<%= 'packet-row' if structured_pkt.present? %>"
                          style="<%= row_style.join('; ') %>"
                          <% if structured_pkt.present? %>
                            data-bs-toggle="collapse" data-bs-target="#<%= detail_id %>"
                            aria-expanded="false" aria-controls="<%= detail_id %>"
                          <% end %>>
                        <%# text-muted is !important and unreadable on the dark
                            Wireshark row colors — colored rows tint uniformly. %>
                        <td class="ps-2 text-nowrap <%= 'text-muted' unless colors %>">
                          <% if structured_pkt.present? %><i class="fas fa-chevron-right packet-row-chevron me-1"></i><% end %><%= pkt[:no] %>
                        </td>
                        <td class="<%= 'text-muted' unless colors %>"><%= pkt[:time] %></td>
                        <td title="<%= pkt[:src_mac] %>"><%= pkt[:src] %></td>
                        <td title="<%= pkt[:dst_mac] %>"><%= pkt[:dst] %></td>
                        <td><%= pkt[:proto] %></td>
                        <td class="<%= 'text-muted' unless colors %>"><%= pkt[:length] %></td>
                        <td class="text-truncate" style="max-width:280px;" title="<%= pkt[:info] %>"><%= pkt[:info] %></td>
                      </tr>
                      <% if structured_pkt.present? %>
                        <tr class="collapse" id="<%= detail_id %>">
                          <td colspan="7" class="p-0 packet-detail-pane">
                            <div class="p-2">
                              <% packet_detail_layers(structured_pkt).each do |layer| %>
                                <% layer_id = "#{detail_id}-#{layer[:key]}" %>
                                <div class="packet-detail-layer">
                                  <div class="packet-detail-layer-label"
                                       data-bs-toggle="collapse" data-bs-target="#<%= layer_id %>"
                                       aria-expanded="false" aria-controls="<%= layer_id %>">
                                    <i class="fas fa-chevron-right packet-detail-layer-chevron me-1"></i><%= layer[:label] %><% if layer[:summary].present? %>, <%= layer[:summary] %><% end %>
                                  </div>
                                  <div class="collapse" id="<%= layer_id %>">
                                    <% layer[:fields].each do |field_label, field_value| %>
                                      <div class="packet-detail-field">
                                        <span class="packet-detail-field-label"><%= field_label %></span>
                                        <span class="packet-detail-field-value"><%= field_value %></span>
                                      </div>
                                    <% end %>
                                  </div>
                                </div>
                              <% end %>
                            </div>
                          </td>
                        </tr>
                      <% end %>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% end %>

            <%# Raw output toggle %>
            <div class="px-2 py-1 border-top packet-light-bar">
              <button class="btn btn-link btn-sm text-secondary p-0"
                      data-bs-toggle="collapse"
                      data-bs-target="#raw-cap-<%= submission.id %>-<%= host_name %>">
                <i class="fas fa-code me-1"></i><%= t(".raw_tcpdump") %>
              </button>
              <div class="collapse" id="raw-cap-<%= submission.id %>-<%= host_name %>">
                <pre class="m-0 p-2 small font-monospace"
                     style="background:#111; color:#8bc34a; max-height:200px; overflow-y:auto; white-space:pre-wrap;"><%= raw %></pre>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      </div>
    </div>
  <% end %>
</div>
