<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t(".title") %></h1>
  <%= link_to t(".browse_exercises"), exercises_path, class: "btn btn-outline-primary" %>
</div>

<% if @submissions.empty? %>
  <div class="alert alert-info text-center">
    <%= t(".no_submissions") %>
    <%= link_to t(".start_an_exercise"), exercises_path %> <%= t(".to_get_going") %>
  </div>
<% else %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th><%= t(".exercise") %></th>
          <th><%= t(".language") %></th>
          <th><%= t(".status") %></th>
          <th><%= t(".submitted") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @submissions.each do |submission| %>
          <tr>
            <td class="fw-semibold"><%= submission.exercise.title %></td>
            <td><span class="badge bg-secondary"><%= submission.exercise.language %></span></td>
            <td>
              <% badge = case submission.status
                         when 'completed'  then 'success'
                         when 'failed'     then 'danger'
                         when 'evaluating' then 'warning'
                         else                   'secondary'
                         end %>
              <span class="badge bg-<%= badge %>"><%= t("submissions.status.#{submission.status}").upcase %></span>
            </td>
            <td class="text-muted small"><%= t(".time_ago", time: time_ago_in_words(submission.created_at)) %></td>
            <td><%= link_to t(".view"), submission, class: "btn btn-sm btn-outline-primary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
