<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Programming Exercises</h1>
  <% if current_user&.admin? %>
    <%= link_to "New Exercise", new_exercise_path, class: "btn btn-primary" %>
  <% end %>
</div>

<div class="row">
  <% @exercises.each do |exercise| %>
    <div class="col-md-6 col-lg-4 mb-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title text-primary"><%= exercise.title %></h5>
            <span class="badge bg-secondary"><%= exercise.language %></span>
          </div>
          <p class="card-text text-muted small">
            Difficulty: 
            <% exercise.difficulty.times do %>
              ⭐
            <% end %>
          </p>
          <p class="card-text"><%= truncate(exercise.description, length: 100) %></p>
          <%= link_to "Start Exercise →", exercise, class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @exercises.empty? %>
  <div class="alert alert-info text-center">
    No exercises available yet. Check back soon!
  </div>
<% end %>
