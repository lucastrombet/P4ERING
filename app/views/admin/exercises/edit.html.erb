<!-- app/views/admin/exercises/edit.html.erb -->
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
          <h2 class="h4 mb-0">
            <i class="fas fa-edit me-2"></i><%= t(".title") %>
          </h2>
        </div>

        <div class="card-body">
          <%= form_with(model: [:admin, @exercise], local: true, class: "needs-validation") do |f| %>

            <% if @exercise.errors.any? %>
              <div class="alert alert-danger">
                <h5 class="alert-heading">
                  <i class="fas fa-exclamation-triangle me-2"></i>
                  <%= t("admin.exercises.form.errors_heading") %>
                </h5>
                <ul class="mb-0">
                  <% @exercise.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- Title Field -->
            <div class="mb-4">
              <%= f.label :title, class: "form-label fw-bold" do %>
                <i class="fas fa-heading me-1"></i> <%= t("admin.exercises.form.title_label") %>
              <% end %>
              <%= f.text_field :title,
                  class: "form-control form-control-lg",
                  placeholder: t("admin.exercises.form.title_placeholder"),
                  required: true %>
            </div>

            <!-- Language Field -->
            <div class="mb-4">
              <%= f.label :language, class: "form-label fw-bold" do %>
                <i class="fas fa-code me-1"></i> <%= t("admin.exercises.form.language_label") %>
              <% end %>
              <%= f.select :language,
                  Exercise::LANGUAGES.map { |lang| [lang, lang] },
                  { include_blank: t("admin.exercises.form.language_placeholder") },
                  { class: "form-select form-select-lg", required: true } %>
            </div>

            <!-- Difficulty Field -->
            <div class="mb-4">
              <%= f.label :difficulty, class: "form-label fw-bold" do %>
                <i class="fas fa-chart-line me-1"></i> <%= t("admin.exercises.form.difficulty_label") %>
              <% end %>

              <div class="difficulty-selector">
                <% (1..5).each do |level| %>
                  <div class="form-check form-check-inline">
                    <%= f.radio_button :difficulty, level,
                        class: "form-check-input",
                        id: "difficulty_#{level}" %>
                    <%= f.label "difficulty_#{level}", class: "form-check-label" do %>
                      <span class="difficulty-label">
                        <% level.times do %>
                          <i class="fas fa-star text-warning"></i>
                        <% end %>
                        <% (5 - level).times do %>
                          <i class="far fa-star text-muted"></i>
                        <% end %>
                        <span class="ms-2">
                          <%= t("exercises.difficulty.#{Exercise::DIFFICULTY_KEYS[level]}") %>
                        </span>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Description Field -->
            <div class="mb-4">
              <%= f.label :description, class: "form-label fw-bold" do %>
                <i class="fas fa-align-left me-1"></i> <%= t("admin.exercises.form.description_label") %>
              <% end %>
              <%= f.text_area :description,
                  rows: 10,
                  class: "form-control",
                  required: true %>
            </div>

            <!-- Traffic Generators Field -->
            <%= render "traffic_generators_section", f: f %>

            <!-- Starter Code Field -->
            <div class="mb-4">
              <%= f.label :starter_code, class: "form-label fw-bold" do %>
                <i class="fas fa-file-code me-1"></i> <%= t("admin.exercises.form.starter_code_label") %>
                <span class="text-muted fw-normal">(<%= t("admin.exercises.form.optional") %>)</span>
              <% end %>
              <%= f.text_area :starter_code,
                  rows: 12,
                  class: "form-control font-monospace",
                  placeholder: t("admin.exercises.form.starter_code_placeholder") %>
              <div class="form-text">
                <%= t("admin.exercises.form.starter_code_hint") %>
              </div>
            </div>

            <%= render 'topology_form', f: f %>

            <!-- Evaluation Criteria Field -->
            <div class="mb-4">
              <%= f.label :evaluation_criteria, class: "form-label fw-bold" do %>
                <i class="fas fa-check-double me-1"></i> <%= t("admin.exercises.form.evaluation_criteria_label") %>
                <span class="text-muted fw-normal">(<%= t("admin.exercises.form.optional") %>)</span>
              <% end %>
              <%= f.text_area :evaluation_criteria,
                  rows: 8,
                  class: "form-control font-monospace",
                  placeholder: t("admin.exercises.form.evaluation_criteria_placeholder") %>
              <div class="form-text">
                <%= t("admin.exercises.form.evaluation_criteria_hint") %>
              </div>
            </div>

            <!-- Restricted -->
            <div class="card mb-4">
              <div class="card-body">
                <div class="form-check form-switch">
                  <%= f.check_box :restricted, class: "form-check-input", role: "switch", id: "exercise_restricted" %>
                  <%= f.label :restricted, class: "form-check-label fw-bold" do %>
                    <i class="fas fa-lock me-1"></i> <%= t("admin.exercises.form.restricted_label") %>
                  <% end %>
                  <div class="form-text"><%= t("admin.exercises.form.restricted_hint") %></div>
                </div>
                <hr>
                <div class="form-check form-switch">
                  <%= f.check_box :visible_by_other_professors, class: "form-check-input", role: "switch", id: "exercise_visible_by_other_professors" %>
                  <%= f.label :visible_by_other_professors, class: "form-check-label fw-bold" do %>
                    <i class="fas fa-share-alt me-1"></i> <%= t("admin.exercises.form.visible_label") %>
                  <% end %>
                  <div class="form-text"><%= t("admin.exercises.form.visible_hint") %></div>
                </div>
              </div>
            </div>

            <!-- Form Actions -->
            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
              <div>
                <%= link_to admin_exercises_path, class: "btn btn-secondary" do %>
                  <i class="fas fa-arrow-left me-1"></i> <%= t("admin.exercises.form.cancel") %>
                <% end %>
                <%= link_to admin_exercise_path(@exercise),
                    method: :delete,
                    class: "btn btn-danger ms-2",
                    data: { confirm: t(".confirm_delete") } do %>
                  <i class="fas fa-trash me-1"></i> <%= t(".delete") %>
                <% end %>
              </div>
              <div>
                <%= f.button type: :submit, class: "btn btn-primary btn-lg" do %>
                  <i class="fas fa-save me-1"></i> <%= t(".submit") %>
                <% end %>
              </div>
            </div>

          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
