<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>User Management</h1>
  <%= link_to "Create New User", new_user_path, class: "btn btn-primary" %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Submissions</th>
        <th>Joined</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.name || 'Not set' %></td>
          <td><%= user.email %></td>
          <td>
            <% if user.admin? %>
              <span class="badge bg-danger">Admin</span>
            <% else %>
              <span class="badge bg-secondary">User</span>
            <% end %>
          </td>
          <td><%= user.submissions.count %></td>
          <td><%= user.created_at.strftime("%Y-%m-%d") %></td>
          <td>
            <%= link_to "Edit", edit_user_path(user), class: "btn btn-sm btn-warning" %>
            <%= button_to "Delete", user_path(user), method: :delete, 
                class: "btn btn-sm btn-danger", 
                data: { confirm: "Are you sure you want to delete this user?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
