<div class="sidebar">
  <div class="user-info text-center mb-4">
    <% if current_user.avatar? %>
      <%= image_tag current_user.avatar, class: "rounded-circle mb-3", width: 80 %>
    <% else %>
      <div class="avatar-placeholder mb-3">
        <i class="fas fa-user-circle fa-4x text-primary"></i>
      </div>
    <% end %>
    <h5><%= current_user.name %></h5>
    <small class="text-muted"><%= current_user.email %></small>
  </div>
  
  <ul class="nav flex-column">
    <li class="nav-item">
      <%= link_to root_path, class: "nav-link" do %>
        <i class="fas fa-home me-2"></i> Dashboard
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to exercises_path, class: "nav-link" do %>
        <i class="fas fa-code me-2"></i> Exercises
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to submissions_path, class: "nav-link" do %>
        <i class="fas fa-history me-2"></i> Submissions
      <% end %>
    </li>
    <% if current_user.admin? %>
      <li class="nav-item">
        <%= link_to admin_dashboard_path, class: "nav-link" do %>
          <i class="fas fa-chart-line me-2"></i> Admin Panel
        <% end %>
      </li>
    <% end %>
    <li class="nav-item mt-4">
      <%= button_to destroy_user_session_path, 
          method: :delete,
          class: "btn btn-danger w-100",
          data: { turbo_confirm: "Are you sure you want to logout?" } do %>
        <i class="fas fa-sign-out-alt me-2"></i> Logout
      <% end %>
    </li>
  </ul>
</div>
