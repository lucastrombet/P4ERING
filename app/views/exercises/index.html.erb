<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t(".title") %></h1>
</div>

<div class="row">
  <% @exercises.each do |exercise| %>
    <div class="col-md-6 col-lg-4 mb-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title text-primary">
              <% if current_user.staff? && exercise.restricted? %>
                <i class="fas fa-lock text-warning me-1" title="<%= t("admin.exercises.index.restricted") %>"></i>
              <% end %>
              <%= exercise.title %>
            </h5>
            <span class="badge bg-secondary"><%= exercise.language %></span>
          </div>
          <p class="card-text text-muted small">
            <%= t(".difficulty") %>:
            <% exercise.difficulty.times do %>
              ⭐
            <% end %>
          </p>
          <p class="card-text"><%= truncate(exercise.description, length: 100) %></p>
          <%= link_to t(".start_exercise"), exercise, class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @exercises.empty? %>
  <div class="alert alert-info text-center">
    <%= t(".no_exercises") %>
  </div>
<% end %>
