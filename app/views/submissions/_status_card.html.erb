<div id="submission-status-card-<%= submission.id %>" class="card mb-3">
  <div class="card-header"><%= t(".result") %></div>
  <div class="card-body">
    <% badge = case submission.status
               when 'completed'  then 'success'
               when 'failed'     then 'danger'
               when 'evaluating' then 'warning'
               else                   'secondary'
               end %>
    <p class="mb-2">
      <% if submission.status == 'evaluating' %>
        <span class="badge bg-warning fs-6">
          <i class="fas fa-spinner fa-spin me-1"></i> <%= t("submissions.status.evaluating").upcase %>
        </span>
      <% else %>
        <span class="badge bg-<%= badge %> fs-6"><%= t("submissions.status.#{submission.status}").upcase %></span>
      <% end %>
      <% unless submission.passed.nil? %>
        <span class="badge bg-<%= submission.passed ? 'success' : 'danger' %> fs-6 ms-1">
          <i class="fas <%= submission.passed ? 'fa-check' : 'fa-times' %> me-1"></i>
          <%= t("submissions.evaluation_result.#{submission.passed ? 'passed' : 'failed'}").upcase %>
        </span>
      <% end %>
    </p>
    <p class="text-muted small mb-0">
      <%= t(".submitted_time_ago", time: time_ago_in_words(submission.created_at)) %>
    </p>
  </div>
</div>
