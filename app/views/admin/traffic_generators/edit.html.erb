<div class="row justify-content-center">
  <div class="col-lg-9">
    <div class="card shadow-sm">
      <div class="card-header bg-warning text-dark">
        <h2 class="h5 mb-0"><i class="fas fa-edit me-2"></i><%= t(".title", name: @traffic_generator.name) %></h2>
      </div>
      <div class="card-body">
        <%= form_with model: [:admin, @traffic_generator], local: true do |f| %>
          <%= render 'form', f: f, traffic_generator: @traffic_generator %>
          <div class="d-flex justify-content-between mt-4 pt-3 border-top">
            <div>
              <%= link_to admin_traffic_generators_path, class: "btn btn-secondary me-2" do %>
                <i class="fas fa-arrow-left me-1"></i> <%= t("admin.traffic_generators.form.cancel") %>
              <% end %>
              <%= button_to admin_traffic_generator_path(@traffic_generator), method: :delete,
                  class: "btn btn-danger",
                  form: { data: { turbo_confirm: t("admin.traffic_generators.index.confirm_remove") } } do %>
                <i class="fas fa-trash me-1"></i> <%= t(".remove") %>
              <% end %>
            </div>
            <%= f.submit t(".submit"), class: "btn btn-warning" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
