<div class="hero-section">
  <h1 class="display-4 fw-bold"><%= t(".welcome") %></h1>
  <p class="lead"><%= t(".subtitle") %></p>
  <% if user_signed_in? %>
    <%= link_to exercises_path, class: "btn btn-light btn-lg px-5" do %>
      <i class="fas fa-code me-2"></i><%= t(".start_practicing") %>
    <% end %>
  <% else %>
    <%= link_to new_user_registration_path, class: "btn btn-light btn-lg px-5 me-3" do %>
      <i class="fas fa-user-plus me-2"></i><%= t(".get_started") %>
    <% end %>
    <%= link_to new_user_session_path, class: "btn btn-outline-light btn-lg px-5" do %>
      <i class="fas fa-sign-in-alt me-2"></i><%= t("layout.nav.login") %>
    <% end %>
  <% end %>
</div>

<div class="row g-4">
  <div class="col-md-4">
    <div class="feature-card">
      <div class="feature-icon">
        <i class="fas fa-project-diagram"></i>
      </div>
      <h3><%= t(".features.topologies.title") %></h3>
      <p><%= t(".features.topologies.body") %></p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="feature-card">
      <div class="feature-icon">
        <i class="fas fa-laptop-code"></i>
      </div>
      <h3><%= t(".features.compile.title") %></h3>
      <p><%= t(".features.compile.body") %></p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="feature-card">
      <div class="feature-icon">
        <i class="fas fa-satellite-dish"></i>
      </div>
      <h3><%= t(".features.inspect.title") %></h3>
      <p><%= t(".features.inspect.body") %></p>
    </div>
  </div>
</div>

<div class="row mt-5">
  <div class="col-md-6">
    <div class="card shadow-hover">
      <div class="card-body">
        <h3 class="card-title text-gradient"><%= t(".why.title") %></h3>
        <ul class="list-unstyled mt-3">
          <li class="mb-3">
            <i class="fas fa-check-circle text-success me-2"></i>
            <strong><%= t(".why.difficulty.title") %>:</strong> <%= t(".why.difficulty.body") %>
          </li>
          <li class="mb-3">
            <i class="fas fa-check-circle text-success me-2"></i>
            <strong><%= t(".why.data_plane.title") %>:</strong> <%= t(".why.data_plane.body") %>
          </li>
          <li class="mb-3">
            <i class="fas fa-check-circle text-success me-2"></i>
            <strong><%= t(".why.feedback.title") %>:</strong> <%= t(".why.feedback.body") %>
          </li>
          <li class="mb-3">
            <i class="fas fa-check-circle text-success me-2"></i>
            <strong><%= t(".why.history.title") %>:</strong> <%= t(".why.history.body") %>
          </li>
        </ul>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card bg-primary text-white shadow-hover">
      <div class="card-body text-center">
        <i class="fas fa-rocket fa-3x mb-3"></i>
        <h3><%= t(".ready.title") %></h3>
        <p class="mb-4"><%= t(".ready.body") %></p>
        <% if user_signed_in? %>
          <%= link_to t(".ready.browse_exercises"), exercises_path, class: "btn btn-light" %>
        <% else %>
          <%= link_to t(".ready.create_account"), new_user_registration_path, class: "btn btn-light" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
