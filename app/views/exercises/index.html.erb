<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="text-gradient">Programming Exercises</h1>
    <p class="text-muted">Choose a challenge and start coding</p>
  </div>
  <% if current_user&.admin? %>
    <%= link_to new_exercise_path, class: "btn btn-primary" do %>
      <i class="fas fa-plus me-2"></i>Create Exercise
    <% end %>
  <% end %>
</div>

<div class="row">
  <% @exercises.each do |exercise| %>
    <div class="col-md-6 col-lg-4 mb-4">
      <div class="exercise-card">
        <div class="exercise-meta">
          <span class="badge bg-info">
            <i class="fas fa-code me-1"></i><%= exercise.language %>
          </span>
          <span class="difficulty-stars">
            <% exercise.difficulty.times do %>
              <i class="fas fa-star"></i>
            <% end %>
            <% (5 - exercise.difficulty).times do %>
              <i class="far fa-star"></i>
            <% end %>
          </span>
        </div>
        
        <h3 class="exercise-title"><%= exercise.title %></h3>
        <p class="text-muted"><%= truncate(exercise.description, length: 100) %></p>
        
        <div class="mt-3">
          <%= link_to exercise_path(exercise), class: "btn btn-primary w-100" do %>
            <i class="fas fa-play me-2"></i>Start Exercise
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @exercises.empty? %>
  <div class="text-center py-5">
    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
    <h3>No exercises available yet</h3>
    <p class="text-muted">Check back soon for new challenges!</p>
  </div>
<% end %>
