<div class="row">
  <div class="col-md-12">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to t("layout.nav.exercises"), exercises_path %></li>
        <li class="breadcrumb-item active"><%= @exercise.title %></li>
      </ol>
    </nav>

    <div class="card mb-4">
      <div class="card-header bg-primary text-white">
        <h2 class="h4 mb-0"><%= @exercise.title %></h2>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <span class="badge bg-info me-2"><%= @exercise.language %></span>
          <span class="badge bg-warning text-dark">
            <% @exercise.difficulty.times do %>★<% end %>
            <%= @exercise.difficulty_label %>
          </span>
        </div>
        <h5><%= t(".description") %>:</h5>
        <p><%= simple_format(@exercise.description) %></p>

        <% if @exercise.traffic_generators.any? %>
          <h5 class="mt-3"><%= t(".traffic_generators") %></h5>
          <div class="d-flex flex-wrap gap-2">
            <% @exercise.traffic_generators.each do |tg| %>
              <div class="border rounded p-2 bg-light">
                <span class="fw-semibold"><%= tg.name %></span>
                <span class="badge <%= tg.protocol == 'UDP' ? 'bg-warning text-dark' : 'bg-primary' %> ms-1"><%= tg.protocol %></span>
                <div class="mt-1"><code class="small"><%= tg.to_iperf_command("<server>") %></code></div>
                <% if tg.description.present? %>
                  <div class="small text-muted mt-1"><%= tg.description %></div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if @exercise.has_topology? %>
  <%= render 'topology_viewer', exercise: @exercise %>
<% end %>

<div class="row">
  <div class="col-md-7">
    <div class="card">
      <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <h3 class="h5 mb-0"><%= t(".submit_your_solution") %></h3>
        <% if @exercise.starter_code.present? %>
          <button type="button" class="btn btn-sm btn-light"
                  onclick="loadStarterCode()"
                  title="<%= t(".load_starter_code_title") %>">
            <i class="fas fa-file-code me-1"></i> <%= t(".load_starter_code") %>
          </button>
        <% end %>
      </div>
      <div class="card-body">
        <%= form_with(model: [@exercise, Submission.new], local: true, data: { turbo: false }, id: "submission-form") do |f| %>
          <div class="mb-3">
            <%= f.label :code, t(".your_code", language: @exercise.language), class: "form-label fw-bold" %>
            <%= f.text_area :code, rows: 15, class: "form-control font-monospace",
                id: "code-editor",
                placeholder: t(".code_placeholder", language: @exercise.language) %>
          </div>
          <div class="d-flex gap-2">
            <%= f.submit t(".submit_solution"), class: "btn btn-success" %>
            <button type="button"
                    class="btn btn-outline-info"
                    title="<%= t(".test_code_title") %>"
                    onclick="submitTestRun()">
              <i class="fas fa-flask me-1"></i> <%= t(".test_code") %>
            </button>
          </div>
        <% end %>

        <%= form_with url: exercise_test_run_path(@exercise), method: :post,
            local: true, data: { turbo: false }, id: "test-run-form" do %>
          <input type="hidden" name="submission[code]" id="test-run-code">
        <% end %>
        <script>
          function submitTestRun() {
            document.getElementById('test-run-code').value = document.getElementById('code-editor').value;
            document.getElementById('test-run-form').submit();
          }
        </script>
      </div>
    </div>

    <% if @exercise.starter_code.present? %>
      <script>
        function loadStarterCode() {
          var editor = document.getElementById('code-editor');
          if (editor.value.trim() !== '' &&
              !confirm(<%= t(".confirm_replace_code").to_json %>)) {
            return;
          }
          editor.value = <%= raw @exercise.starter_code.to_json %>;
        }
      </script>
    <% end %>
  </div>

  <div class="col-md-5">
    <div class="card">
      <div class="card-header bg-info text-white">
        <h3 class="h5 mb-0"><%= t(".previous_submissions") %></h3>
      </div>
      <div class="card-body" style="max-height: 500px; overflow-y: auto;">
        <% if @previous_submissions.present? %>
          <% @previous_submissions.each do |sub| %>
            <div class="border rounded p-3 mb-3">
              <div class="d-flex justify-content-between mb-2">
                <small class="text-muted"><%= t(".time_ago", time: time_ago_in_words(sub.created_at)) %></small>
                <span class="badge bg-<%= sub.status == 'completed' ? 'success' : 'warning' %>">
                  <%= t("submissions.status.#{sub.status}").upcase %>
                </span>
              </div>
              <pre class="small mb-2" style="background: #f8f9fa; padding: 8px; border-radius: 4px;"><%= truncate(sub.code, length: 150) %></pre>
              <%= link_to t(".view_details"), sub, class: "btn btn-sm btn-outline-primary" %>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted text-center"><%= t(".no_submissions") %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
