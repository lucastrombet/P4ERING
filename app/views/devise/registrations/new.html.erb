<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow-lg border-0 mt-4">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <%= image_tag "/p4ering_full_ring.svg", alt: "P4ering", height: "110" %>
          <h2 class="h4 fw-bold mt-3 mb-0"><%= t(".sign_up") %></h2>
        </div>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :name, class: "form-label fw-semibold" do %>
              <i class="fas fa-user me-1"></i> <%= f.object.class.human_attribute_name(:name) %>
            <% end %>
            <%= f.text_field :name, autofocus: true, class: "form-control form-control-lg", required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :email, class: "form-label fw-semibold" do %>
              <i class="fas fa-envelope me-1"></i> <%= f.object.class.human_attribute_name(:email) %>
            <% end %>
            <%= f.email_field :email, autocomplete: "email", class: "form-control form-control-lg", required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :password, class: "form-label fw-semibold" do %>
              <i class="fas fa-lock me-1"></i> <%= f.object.class.human_attribute_name(:password) %>
            <% end %>
            <% if @minimum_password_length %>
              <span class="text-muted small">(<%= t(".minimum_password_length", count: @minimum_password_length) %>)</span>
            <% end %>
            <%= f.password_field :password, autocomplete: "new-password", class: "form-control form-control-lg", required: true %>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, class: "form-label fw-semibold" do %>
              <i class="fas fa-lock me-1"></i> <%= f.object.class.human_attribute_name(:password_confirmation) %>
            <% end %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control form-control-lg", required: true %>
          </div>

          <div class="d-grid">
            <%= f.submit t(".submit"), class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

        <hr class="my-4">

        <div class="text-center small">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
