<nav aria-label="breadcrumb" class="mb-2">
  <%= link_to t(".breadcrumb"), classrooms_path %>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1><%= @classroom.name %></h1>
    <p class="text-muted mb-0"><%= @classroom.description %></p>
  </div>
</div>

<h5 class="fw-semibold mb-3"><%= t(".exercises_title") %></h5>

<% if @exercises.any? %>
  <div class="row">
    <% @exercises.each_with_index do |exercise, index| %>
      <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title text-primary">
                <span class="badge bg-secondary me-1"><%= index + 1 %></span>
                <%= exercise.title %>
              </h5>
            </div>
            <p class="card-text text-muted small">
              <%= t("exercises.index.difficulty") %>:
              <% exercise.difficulty.times do %>
                ⭐
              <% end %>
            </p>
            <p class="card-text"><%= truncate(exercise.description, length: 100) %></p>
            <%= link_to t("exercises.index.start_exercise"), exercise, class: "btn btn-outline-primary btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info text-center">
    <%= t(".no_exercises") %>
  </div>
<% end %>
