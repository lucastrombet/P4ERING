<h1 class="mb-4"><i class="fas fa-chalkboard-teacher me-2"></i><%= t(".title") %></h1>

<div class="row mb-4">
  <div class="col-md-4">
    <div class="card text-white bg-success">
      <div class="card-body">
        <h5 class="card-title"><i class="fas fa-book me-2"></i><%= t(".exercises") %></h5>
        <p class="card-text display-4"><%= @exercises.count %></p>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card text-white bg-info">
      <div class="card-body">
        <h5 class="card-title"><i class="fas fa-paper-plane me-2"></i><%= t(".total_submissions") %></h5>
        <p class="card-text display-4"><%= @total_submissions %></p>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card text-white bg-primary">
      <div class="card-body">
        <h5 class="card-title"><i class="fas fa-check-circle me-2"></i><%= t(".completed") %></h5>
        <p class="card-text display-4"><%= @completed_submissions %></p>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="card mb-4">
      <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-bolt me-2"></i><%= t(".quick_actions") %></h5>
      </div>
      <div class="card-body d-flex flex-wrap gap-2">
        <%= link_to admin_exercises_path, class: "btn btn-primary btn-sm" do %>
          <i class="fas fa-code me-1"></i> <%= t(".manage_exercises") %>
        <% end %>
        <%= link_to new_admin_exercise_path, class: "btn btn-success btn-sm" do %>
          <i class="fas fa-plus me-1"></i> <%= t(".new_exercise") %>
        <% end %>
        <%= link_to admin_traffic_generators_path, class: "btn btn-secondary btn-sm" do %>
          <i class="fas fa-network-wired me-1"></i> <%= t(".traffic_generators") %>
        <% end %>
        <%= link_to professor_classrooms_path, class: "btn btn-outline-primary btn-sm" do %>
          <i class="fas fa-chalkboard me-1"></i> <%= t("layout.nav.classrooms") %>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-book-open me-2"></i><%= t(".exercises") %></h5>
      </div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th><%= t("admin.exercises.index.columns.title") %></th>
              <th><%= t("admin.exercises.index.columns.difficulty") %></th>
              <th><%= t("admin.exercises.index.columns.submissions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @exercises.each do |exercise| %>
              <tr>
                <td><%= link_to exercise.title, edit_admin_exercise_path(exercise) %></td>
                <td><span class="badge bg-secondary"><%= exercise.difficulty_label %></span></td>
                <td><%= exercise.submissions.count %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-history me-2"></i><%= t(".recent_submissions") %></h5>
        <% if @pending_submissions > 0 %>
          <span class="badge bg-warning text-dark"><%= @pending_submissions %> <%= t(".pending_badge") %></span>
        <% end %>
      </div>
      <div class="card-body p-0" style="max-height: 420px; overflow-y: auto;">
        <% @submissions.each do |submission| %>
          <div class="border-bottom px-3 py-2">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <strong><%= submission.user.name || submission.user.email %></strong>
                <span class="text-muted"> — </span>
                <%= link_to submission.exercise.title, submission_path(submission) %>
              </div>
              <span class="badge bg-<%= submission.status == 'completed' ? 'success' : submission.status == 'failed' ? 'danger' : 'warning' %>">
                <%= t("submissions.status.#{submission.status}") %>
              </span>
            </div>
            <small class="text-muted"><%= t(".time_ago", time: time_ago_in_words(submission.created_at)) %></small>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
